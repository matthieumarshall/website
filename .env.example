# Copy this file to .env before starting the dev server.
# `just sync` does this automatically on first run.
#
# The dev server loads .env automatically via `uvicorn --env-file .env`.
# Never commit .env — it is listed in .gitignore.
#
# See docs/environments.md for a full guide to local dev, testing, and production.

# Signs session cookies.
# Generate a value with: python -c "import secrets; print(secrets.token_hex(32))"
# Leaving blank in development is fine — an insecure placeholder key is used.
SECRET_KEY=

# Set to true on a live server to enforce HTTPS-only cookies and HSTS.
# Must be false locally or tests will break.
PRODUCTION=false

# Override the DuckDB database path (default: data/app.duckdb).
# DATABASE_URL=data/app.duckdb

# ---------------------------------------------------------------------------
# Stripe (team entries payments)
# ---------------------------------------------------------------------------
# LOCAL DEV + TESTING: use test keys from https://dashboard.stripe.com/test/apikeys
# PRODUCTION: replace with live keys (sk_live_…, pk_live_…) from the dashboard.
#
# For local webhook forwarding, run:
#   stripe listen --forward-to localhost:8000/webhooks/stripe
# and copy the printed whsec_… value below.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ---------------------------------------------------------------------------
# England Athletics TRAPI API (team entries athlete lookup)
# ---------------------------------------------------------------------------
# LOCAL DEV: use production EA endpoint (EA_STAGING=false) with production credentials.
#   Real athlete data is returned. Keep the cert in data/ (gitignored).
# TESTING (CI/local): use staging EA endpoint (EA_STAGING=true) with staging credentials.
#   Set EA_TEST_MODE=true to skip all EA network calls and return dummy athletes instead.
# PRODUCTION: use production EA endpoint (EA_STAGING=false) with production credentials.
#
# Staging credentials (for testing only):
#   EA_CALL_KEY=eventprov2  EA_CALL_SECRET=$33#(sport2
#   EA_CERT_PATH=data/TrApiStagingEVENT2ClientCert.pfx  EA_CERT_PASSWORD=EvSTg@561760v2

# Set to false for local dev and production (live EA endpoint).
# Set to true for testing (EA staging endpoint).
EA_STAGING=false

# Set to true to skip all EA network calls and return dummy athletes (unit tests only).
# EA_TEST_MODE=false

EA_CALL_KEY=
EA_CALL_SECRET=
EA_CERT_PATH=data/<your-ea-cert>.pfx
EA_CERT_PASSWORD=
