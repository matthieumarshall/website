[run]
source = src/website
omit =
    */venv/*
    */site-packages/*
    */tests/*
    */test_*.py
    __pycache__/*
    .venv/*
    tests/*

[report]
# Ratchet: raise as coverage improves, never lower (constitution minimum is 85).
fail_under = 90
show_missing = true
skip_covered = true
exclude_lines =
    pragma: no cover
    def __repr__
    raise AssertionError
    raise NotImplementedError
    if __name__ == .__main__.:
    if TYPE_CHECKING:
    @abstract
    @property
